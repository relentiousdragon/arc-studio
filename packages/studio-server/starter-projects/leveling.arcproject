{
  "format": "arc-project",
  "version": 1,
  "project": {
    "name": "Leveling Bot",
    "createdWithVersion": "2026.1.1-alpha.6",
    "starter": {
      "id": "leveling",
      "name": "Leveling Bot",
      "description": "Track message activity and show community progress.",
      "icon": "TrendingUp",
      "highlights": [
        "Human message activity counter",
        "Goal checks with current and remaining totals",
        "Live range and community choice commands",
        "Welcome card and optional join message",
        "Six rotating bot activities, updated every ten minutes"
      ],
      "setup": [
        "The counter is shared by the server and resets when the bot process restarts.",
        "Set welcome-channel-id in Project Variables to enable automatic welcome messages.",
        "Enable the Server Members Intent for member join messages.",
        "Edit Bot Presence to change the activity messages and timing."
      ],
      "order": 4
    }
  },
