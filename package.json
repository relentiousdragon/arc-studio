{
  "name": "arc-monorepo",
  "version": "2026.1.1-nightly.9",
  "arcStudio": {
    "minimumClientVersion": "2026.1.1-nightly.9"
  },
  "private": true,
  "description": "Visual Discord Bot Creator Studio",
  "author": "relentiousdragon (https://github.com/relentiousdragon)",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "sync:version": "node scripts/sync-version.mjs",
    "start": "npm run start --workspace=packages/studio-server",
    "start:server": "npm run start:server --workspace=packages/studio-server",
    "dev:server": "npm run dev --workspace=packages/studio-server",
    "dev:client": "npm run dev --workspace=packages/studio-client",
    "dev:desktop:services": "concurrently -k -n server,client \"npm:dev:desktop --workspace=packages/studio-server\" \"npm:dev:client\"",
    "dev:desktop": "npm run dev --workspace=packages/studio-desktop",
    "prepare:desktop-runtime": "npm run sync:version && node packages/studio-desktop/scripts/prepare-runtime.mjs",
    "prepare:desktop": "npm run sync:version && npm run build:client && npm run prepare:desktop-runtime",
    "build:desktop": "npm run build --workspace=packages/studio-desktop",
    "dev": "npm run dev --workspace=packages/studio-server",
    "build:client": "npm run sync:version && npm run build --workspace=packages/studio-client && node scripts/mark-client-build.mjs",
    "build": "npm run build:client",
    "test:chezcord": "npm run test --workspace=packages/chezcord",
    "test:server": "npm run test --workspace=packages/studio-server",
    "test": "npm run test:chezcord && npm run test:server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
